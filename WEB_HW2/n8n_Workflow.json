        "jsCode": "\nconst htmlContent = $input.first().json.content.parts[0].text;\n\n// 2. Create the binary file object manually\nconst binaryData = {\n  data: Buffer.from(htmlContent).toString('base64'),\n  mimeType: 'text/html',\n  fileExtension: 'html',\n  fileName: 'TravelGuide.html'\n};\n\n// 3. Return the data to the next node (Gmail)\nreturn {\n  json: $input.first().json, // Keep the text data flow\n  binary: {\n    data: binaryData // This 'data' key is what you will type in the Gmail node\n  }\n};"
